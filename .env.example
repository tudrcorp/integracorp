APP_NAME=IntegraCorp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://www.integracorp.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=operaciones
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tudrencasa.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_API_KEY=

VIVEPLUS_DOCUMENTS_WEBHOOK_URL=
VIVEPLUS_DOCUMENTS_WEBHOOK_TOKEN=
VIVEPLUS_DOCUMENTS_WEBHOOK_SECRET=

CRM_HANDOFF_SECRET=
CRM_HANDOFF_TOLERANCE=300
# Producción: redis + crm-inbox. Local sin Redis: sync + file. database se ignora.
CRM_HANDOFF_QUEUE_CONNECTION=redis
CRM_HANDOFF_CACHE_STORE=crm-inbox
CRM_HANDOFF_QUEUE=inbox
CRM_HANDOFF_RATE_PER_MINUTE=600
REDIS_CRM_DB=2
# Silencia al bot cuando el analista pulsa Tomar. Vacío: el botón avisa y no llama.
CRM_N8N_TAKEOVER_URL=http://127.0.0.1:5678/webhook/handoff/takeover
# Vacío: usa la URL de Tomar cambiando takeover por reply.
CRM_N8N_REPLY_URL=
# Vacío: usa la URL de Tomar cambiando takeover por document.
CRM_N8N_DOCUMENT_URL=
# Vacío: usa la URL de Tomar cambiando takeover por release.
CRM_N8N_RELEASE_URL=
CRM_N8N_HANDOFF_KEY=
# Avisos del navegador cuando llega un caso. Vacío: el botón no se muestra.
CRM_PUSH_VAPID_PUBLIC_KEY=
CRM_PUSH_VAPID_PRIVATE_KEY=
CRM_PUSH_VAPID_SUBJECT=mailto:crm@tudrencasa.com
CRM_INBOX_SLA_WARN_MINUTES=5
CRM_INBOX_SLA_LATE_MINUTES=15
CRM_INBOX_QUOTE_CURRENCY=USD

INTEGRACORP_API_BASE_URL=http://127.0.0.1:4000
INTEGRACORP_API_KEY=

VITE_APP_NAME="${APP_NAME}"
